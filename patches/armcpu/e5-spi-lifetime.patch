+  if (ml_at_interrupt_context()) return kIOReturnNotPermitted;
+  SpiWriterGuard guard;
+  ArmCpuSpi *entry = findSpi(id);
+  if (!entry || entry->ownership == ArmCpuSpi::Vacant) return kIOReturnNotOpen;
+  if (entry->context != context) return kIOReturnExclusiveAccess;
+  if (enable && entry->ownership != ArmCpuSpi::Live) return kIOReturnNotPermitted;
+  const uint32_t word = (id / 32) * 4, bit = 1u << (id % 32);
+  write32(gDist, (enable ? 0x100 : 0x180) + word, bit);
+  if (!waitClear(gDist, 0, 1u << 31)) return kIOReturnTimeout;
+  return bool(read32(gDist, 0x100 + word) & bit) == enable ? kIOReturnSuccess : kIOReturnIOError;
