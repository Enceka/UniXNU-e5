+  SpiWriterGuard guard;
+  if (entry->context != context || entry->ownership != ArmCpuSpi::Closing) return kIOReturnExclusiveAccess;
+  entry->handler = nullptr; entry->context = nullptr; entry->ownership = ArmCpuSpi::Vacant;
