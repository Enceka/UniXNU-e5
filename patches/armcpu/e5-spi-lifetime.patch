+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+#include <IOKit/IOReturn.h>
+
+extern "C" {
+IOReturn armcpu_spi_attach(uint32_t, bool, void (*)(void *), void *, uint32_t *, uint64_t *);
+IOReturn armcpu_spi_attach_masked(uint32_t, bool, void (*)(void *), void *, uint32_t *, uint64_t *);
+IOReturn armcpu_spi_set_enabled(uint32_t, bool, void *);
+// Only an executing owner callback may call this IRQ-safe containment path.
+void armcpu_spi_mask_irq(uint32_t, void *);
+// Thread context only. Success guarantees no callback can use context again.
+// Timeout keeps ownership/context alive and forbids unmask or reattachment.
+IOReturn armcpu_spi_detach(uint32_t, void *);
+uint64_t armcpu_spi_count(uint32_t);
+uint32_t armcpu_spi_control(void);
+}
diff --git a/README.md b/README.md
index 68e713b..f56c275 100644
--- a/README.md
+++ b/README.md
@@ -5,3 +5,22 @@ ARM generic interrupt controller and timer.
 starts the CPU, GIC and timer on sheng and on the QEMU virt machine.
 
 Build and interface details: [documentation](https://unixnu.com/reference/components). Component sources and dependencies: [catalog](https://unixnu.com/reference/components).
+
+Shared peripheral SPI callbacks run in primary interrupt context before EOIR.
+The original `armcpu_spi_attach` configures and enables an SPI. The additional
+`armcpu_spi_attach_masked` publishes the same handler while leaving the parent
+masked; its owner later calls `armcpu_spi_set_enabled`. Calls are serialized
+and accept an owner context, preventing another owner from changing the line.
+
+`armcpu_spi_detach` masks the parent and closes an atomic callback-entry gate.
+Success guarantees all existing callbacks have returned and no new callback
+can use the context. A timeout leaves ownership closed and context retained;
+callers must keep resources alive and may retry. Detached slots retain their
+immutable INTID and can be reused for that INTID. These management calls are
+thread-context operations. An executing owner callback can contain an unknown
+level source with the bounded `armcpu_spi_mask_irq` operation.
+
+Callback/context fields change only behind a closed, drained gate. Host
+ASan/UBSan tests in `tests/spi-gate.cpp` exercise concurrent entry, closure,
+heap-context retirement and reuse. Build with `build-arm-driver.py ArmCpu`
+in the resolved kernel tree. Device qualification remains separate.
diff --git a/SpiGate.h b/SpiGate.h
new file mode 100644
index 0000000..594a15d
--- /dev/null
+++ b/SpiGate.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#pragma once
+#include <stdint.h>
+
+// One atomic word closes entry and counts borrowers. After close(), a CAS
+// either joined the count beforehand or fails against the closed bit.
+// Callback/context storage may change only while closed and quiescent.
+struct ArmCpuSpiGate {
+  static constexpr uint32_t Closed = 1u << 31;
+  uint32_t state = Closed;
+  bool enter() {
+    uint32_t value = __atomic_load_n(&state, __ATOMIC_ACQUIRE);
+    while (!(value & Closed) && value != Closed - 1) {
+      if (__atomic_compare_exchange_n(&state, &value, value + 1, false,
+                                      __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return true;
+    }
+    return false;
+  }
+  void leave() { __atomic_fetch_sub(&state, 1u, __ATOMIC_RELEASE); }
+  void close() { __atomic_fetch_or(&state, Closed, __ATOMIC_ACQ_REL); }
+  uint32_t active() const { return __atomic_load_n(&state, __ATOMIC_ACQUIRE) & ~Closed; }
+  bool open() {
+    uint32_t expected = Closed;
+    return __atomic_compare_exchange_n(&state, &expected, 0u, false,
+                                       __ATOMIC_RELEASE, __ATOMIC_RELAXED);
+  }
+};
diff --git a/tests/spi-gate.cpp b/tests/spi-gate.cpp
new file mode 100644
index 0000000..c8b4cf5
--- /dev/null
+++ b/tests/spi-gate.cpp
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include "../SpiGate.h"
+#include <atomic>
+#include <cassert>
+#include <thread>
+#include <vector>
+#include <iostream>
+
+int main() {
+  ArmCpuSpiGate gate;
+  assert(!gate.enter() && gate.active() == 0 && gate.open());
+  assert(gate.enter()); gate.close();
+  assert(gate.active() == 1 && !gate.enter() && !gate.open());
+  gate.leave(); assert(gate.active() == 0 && gate.open()); gate.close();
+  // Exercise retirement of actual heap context while concurrent dispatchers
+  // repeatedly borrow it. The closed gate must exclude all post-retirement reads.
+  for (unsigned epoch = 0; epoch < 150; ++epoch) {
+    int *context = new int(37);
+    std::atomic<bool> stop{false}; std::atomic<unsigned> reads{0};
+    assert(gate.open());
+    std::vector<std::thread> threads;
+    for (unsigned i = 0; i < 4; ++i) threads.emplace_back([&] {
+      while (!stop.load(std::memory_order_acquire)) {
+        if (gate.enter()) {
+          assert(*context == 37); ++reads; gate.leave();
+        }
+      }
+    });
+    while (reads.load() < 200) std::this_thread::yield();
+    gate.close();
+    while (gate.active()) std::this_thread::yield();
+    delete context;
+    for (unsigned i = 0; i < 1000; ++i) assert(!gate.enter());
+    stop.store(true, std::memory_order_release);
+    for (auto &thread : threads) thread.join();
+  }
+  std::cout << "PASS: gate closure rejects new borrowers, drains old callbacks and permits safe context retirement/reuse\n";
+}
