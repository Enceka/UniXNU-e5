+		if (e5fb) {
+			volatile uint32_t * e5fh = (volatile uint32_t *)e5fb;
+			if (e5fh[0] == 0x4C463545u && e5fh[1] > 0) {    /* "E5FL" */
+				uint32_t e5total = e5fh[1];
+				uint32_t e5len = e5total > 768u ? 768u : e5total;
+				uint32_t e5start = (e5total - e5len) & 0x3FFFu;
+				volatile unsigned char * e5ring = (volatile unsigned char *)e5fb + 0x20;
+				char e5line[65];
+				uint32_t e5fill = 0, e5seen = 0;
+				printf("E5-FLIGHT-PREV: total %u bytes, tail %u:\n", e5total, e5len);
+				while (e5seen < e5len) {
+					unsigned char e5ch = e5ring[(e5start + e5seen++) & 0x3FFFu];
+					e5line[e5fill++] = (e5ch >= 0x20 && e5ch < 0x7F) ? e5ch : '.';
+					if (e5fill == 64) {
