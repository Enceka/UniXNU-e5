+/*
+ * E5 console flight recorder: 16 KiB wrapping ring + monotonic counter in
+ * PRAM at 0x9F020000, outside the 64 KiB panic-pram window at 0x9F000000
+ * that the debug ring reuses.  Mirrors console bytes from conslog_putc
+ * (printf main path, survives the console device switch to E5FB) and the
+ * panic path, so the LAST console output of a boot - panic text included
+ * - survives resets that the ramoops console zones cannot.
+ */
+int e5flight_armed;
+static vm_offset_t e5flight_base;
 
 void
+e5flight_putc(char c)
+{
+	if (!e5flight_armed) {
+		return;
+	}
+	if (e5flight_base == 0) {
+		e5flight_base = ml_io_map_wcomb(0x9F020000ULL, 0x4020ULL);
+		if (e5flight_base == 0) {
+			e5flight_armed = 0;
+			return;
+		}
+	}
+	volatile uint32_t * fh = (volatile uint32_t *)e5flight_base;
+	uint32_t n = fh[1];
+	((volatile unsigned char *)e5flight_base + 0x20)[n & 0x3FFFu] = (unsigned char)c;
+	__builtin_arm_dmb(0xBULL);
+	fh[1] = n + 1;
+	fh[0] = 0x4C463545u;
+}
+
+/*
+ * Dump the previous boot's ring tail via direct prz writes (printf is not
+ * up yet where this is called from), then consume the header.
+ */
+void
+e5flight_dump(void)
+{
+	vm_offset_t fb = ml_io_map_wcomb(0x9F020000ULL, 0x4020ULL);
+	if (fb == 0) {
+		return;
+	}
+	volatile uint32_t * fh = (volatile uint32_t *)fb;
+	if (fh[0] == 0x4C463545u && fh[1] > 0) {
+		uint32_t total = fh[1];
+		uint32_t len = total > 768u ? 768u : total;
+		uint32_t start = (total - len) & 0x3FFFu;
+		volatile unsigned char * ring = (volatile unsigned char *)fb + 0x20;
+		char line[65];
+		char hdr[80];
+		uint32_t fill = 0, seen = 0;
+		extern void e5_panic_print(const char *);
+		snprintf(hdr, sizeof(hdr), "E5-FLIGHT-PREV: total %u bytes, tail %u", total, len);
+		e5_panic_print(hdr);
+		while (seen < len) {
+			unsigned char ch = ring[(start + seen++) & 0x3FFFu];
+			line[fill++] = (ch >= 0x20 && ch < 0x7F) ? ch : '.';
+			if (fill == 64) {
+				line[64] = 0;
+				e5_panic_print(line);
+				fill = 0;
+			}
+		}
+		if (fill) {
+			line[fill] = 0;
+			e5_panic_print(line);
+		}
+	}
+	fh[0] = 0;
+}
