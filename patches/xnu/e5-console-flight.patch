+/*
+ * E5: PRAM flight recorder.  Mirror console bytes into a 16 KiB ring at
+ * physical 0x9F020000 - DRAM that survives warm reset, deliberately OUTSIDE
+ * the 64 KiB panic-pram window at 0x9F000000 that this boot's own debug
+ * ring reuses.  debug_log_init dumps the previous boot's ring and then
+ * arms this recorder, so the true final state of a boot - panic text
+ * included - survives even when the ramoops console zones filled long
+ * before the boot ended.
+ */
+#if defined(__arm64__)
+int e5flight_armed;
+static volatile unsigned char * e5fr_ring;
+static uint32_t e5fr_n;
 
 void
+e5flight_putc(char c)
+{
+	if (!e5flight_armed) {
+		return;
+	}
+	if (e5fr_ring == NULL) {
+		vm_offset_t base = ml_io_map_wcomb(0x9F020000ULL, 0x4020ULL);
+		if (!base) {
+			e5flight_armed = 0;     /* mapping failed: no recorder */
+			return;
+		}
+		e5fr_ring = (volatile unsigned char *)(base + 0x20);
+		*(volatile uint32_t *)(base + 0) = 0x4C463545u;   /* "E5FL" */
+		*(volatile uint32_t *)(base + 4) = 0;
+		__asm__ volatile ("dmb ish" ::: "memory");
+	}
+	e5fr_ring[e5fr_n & 0x3FFFu] = (unsigned char)c;
+	__asm__ volatile ("dmb ish" ::: "memory");
+	*(volatile uint32_t *)((uintptr_t)e5fr_ring - 0x20 + 4) = ++e5fr_n;
+}
+#else
+void
+e5flight_putc(__unused char c)
+{
+}
+#endif
+
+void
 conslog_putc(char c)
 {
+	e5flight_putc(c);
 	console_write_char(c);
 
