+						printf("E5-FLIGHT-PREV: %s\n", e5line);
+						e5fill = 0;
+					}
+				}
+				if (e5fill) {
+					e5line[e5fill] = 0;
+					printf("E5-FLIGHT-PREV: %s\n", e5line);
+				}
+			}
+			e5fh[0] = 0;    /* consume: a later reboot must not re-dump */
+		}
+		e5flight_armed = 1;
+	}
 
