diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index bca4c7c..ab75b81 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -464,6 +464,17 @@ start_cpu:
 	.globl EXT(start_first_cpu)
 LEXT(start_first_cpu)
 
+.macro E5MARK, paLo, tagHi, tagLo
+	movz	x16, #0xFFF8, lsl #16
+	movk	x16, #\paLo
+	movz	x17, #\tagHi, lsl #16
+	movk	x17, #\tagLo
+	str	x17, [x16]
+	dc	cvac, x16
+.endmacro
+
+E5MARK 0x7F1B, 0x3153, 0x3545   // E5S1 reached start_first_cpu
+
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
@@ -484,6 +495,8 @@ LEXT(start_first_cpu)
 	adrp	x25, EXT(bootstrap_pagetables)@page	// Get the start of the page tables
 	ldr		x26, [x20, BA_BOOT_FLAGS]			// Get the kernel boot flags
 
+	E5MARK 0x7F23, 0x3253, 0x3545   // E5S2 args loaded
+
 	// Clear the registers that will be used to store the userspace thread pointer and CPU number.
 	// We may not actually be booting from ordinal CPU 0, so this register will be updated
 	// in ml_parse_cpu_topology(), which happens later in bootstrap.
@@ -504,6 +517,7 @@ LEXT(start_first_cpu)
 #endif
 
 	mov		sp, x0
+	E5MARK 0x7F2B, 0x3353, 0x3545   // E5S3 stacks set
 
 	// Set up interrupt stack pointer
 	adrp	x0, EXT(intstack_top)@page			// Load top of irq stack
@@ -617,6 +631,15 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+	/* E5: identity-map the persistent ram console (0xFFE00000, 32MB block)
+	 * into the V=P table so PA==VA writes (ram console at 0xFFF80000) work
+	 * from MMU enable until arm_vm_init() installs the real kernel map. */
+	mov		x0, #(0xFFE00000)
+	mov		x4, #(0xFFE00000)
+	mov		x5, #(1)
+	create_bootstrap_mapping x0, x4, x5, x1, x2, x6, x10, x11, x12, x13
+	E5MARK 0x7F33, 0x3453, 0x3545   // E5S4 bootstrap page tables built
+
 	b Lbootstrap_tables_ready
 Lbootstrap_tables_exhausted:
 	// MMU is still off. Stop with the offending cursor/end preserved for
@@ -658,6 +681,7 @@ common_start:
 	add		x0, x0, EXT(sysreg_restore)@pageoff
 	ldr		x1, [x0, SR_RESTORE_TCR_EL1]
 	MSR_TCR_EL1_X1
+	E5MARK 0x7F3B, 0x3553, 0x3545   // E5S5 TCR set
 
 	/* Set up translation table base registers.
 	 *	TTBR0 - V=P table @ top of kernel
@@ -672,9 +696,11 @@ common_start:
 	mov		x19, lr
 	bl		EXT(set_mmu_ttb)
 	mov		lr, x19
+	E5MARK 0x7F53, 0x3535, 0x3545   // E5Sa set_mmu_ttb returned
 	add		x0, x25, PGBYTES
 	and		x0, x0, #(TTBR_BADDR_MASK)
 	MSR_TTBR1_EL1_X0
+	E5MARK 0x7F5B, 0x3635, 0x3545   // E5Sb TTBR1 done
 
 	// Set up MAIR attr0 for normal memory, attr1 for device memory
 	mov		x0, xzr
@@ -702,23 +728,19 @@ common_start:
 	orr		x0, x0, x1
 #endif /* HAS_FEAT_XS */
 	msr		MAIR_EL1, x0
+	E5MARK 0x7F63, 0x3735, 0x3545   // E5Sc MAIR done
 	isb
-	tlbi	vmalle1
+	E5MARK 0x7F73, 0x3935, 0x3545   // E5Se after isb
+	nop		// E5: tlbi vmalle1 broadcast never completes on UMS9621 (parked
+			// secondaries never ACK inner-shareable TLB maintenance); skip it.
+	E5MARK 0x7F7B, 0x3036, 0x3545   // E5Sf after tlbi (tag E560)
 	dsb		ish
+	E5MARK 0x7F83, 0x3136, 0x3545   // E5Sg after dsb (tag E561)
 
 
-#if defined(BCM2837) && (!defined(XNU_NATIVE_ARCH_TIMER) || !XNU_NATIVE_ARCH_TIMER)
-	// Setup timer interrupt routing; must be done before MMU is enabled
-	mrs		x15, MPIDR_EL1						// Load MPIDR to get CPU number
-	and		x15, x15, #0xFF						// CPU number is in MPIDR Affinity Level 0
-	mov		x0, #0x4000
-	lsl		x0, x0, #16
-	add		x0, x0, #0x0040						// x0: 0x4000004X Core Timers interrupt control
-	add		x0, x0, x15, lsl #2
-	mov		w1, #0xF0 						// x1: 0xF0 	  Route to Core FIQs
-	str		w1, [x0]
-	isb		sy
-#endif
+#if 0 // E5: BCM2837 core-timer routing write (unmapped 0x4000004X) faults on UMS9621
+	#endif
+	E5MARK 0x7F43, 0x3653, 0x3545   // E5S6 BCM2837 timer routing done
 
 #ifndef __ARM_IC_NOALIAS_ICACHE__
 	/* Invalidate the TLB and icache on systems that do not guarantee that the
@@ -761,15 +783,17 @@ common_start:
 	PAC_INIT_KEY_STATE tmp=x0, tmp2=x1
 #endif /* HAS_APPLE_PAC */
 
+	E5MARK 0x7F4B, 0x3753, 0x3545   // E5S7 before MMU on
 	// Enable caches, MMU, ROP and JOP
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
 	isb		sy
+	E5MARK 0x7F8B, 0x7853, 0x3545	// E5Sx MMU on
 
 #if !VMAPPLE
-	MOV64   x1, SCTLR_EL1_DEFAULT
-	cmp		x0, x1
-	bne		.
+	// E5: A53 readback of RES0 bits (bit20/UCI/SED...) differs from the
+	// written Apple-oriented value; skip the spin check.
+	nop
 #endif /* !VMAPPLE */
 
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
@@ -782,10 +806,12 @@ common_start:
 	// Enable NEON
 	mov		x0, #(CPACR_FPEN_ENABLE)
 	msr		CPACR_EL1, x0
+	E5MARK 0x7F93, 0x316D, 0x3545	// E5m1 CPACR done (tag E5m1)
 #endif
 
 	// Clear thread pointer
 	msr		TPIDR_EL1, xzr						// Set thread register
+	E5MARK 0x7F9B, 0x326D, 0x3545	// E5m2 TPIDR done (tag E5m2)
 
 
 #if defined(APPLE_ARM64_ARCH_FAMILY)
@@ -816,6 +842,7 @@ common_start:
 	// Set KVA of boot args as first arg
 	add		x0, x20, x22
 	sub		x0, x0, x23
+	E5MARK 0x7FA3, 0x336D, 0x3545	// E5m3 args KVA done (tag E5m3)
 
 #if KASAN
 	mov	x20, x0
