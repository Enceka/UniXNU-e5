diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index 715c545..aba4a0a 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -249,9 +249,120 @@ get_cons_ops_index(void)
  * @param poll Whether or not this call should poll instead of going to sleep
  *             waiting for an interrupt when the hardware device isn't ready
  */
+
+/* E5 ram console tee: mirror every console character into the persistent
+ * dmesg ramoops zone so the trace survives the reset back to Android.
+ * Phase 0 runs before arm_vm_init() with the MMU off (physical addressing),
+ * phase 1 uses an uncached device mapping created by e5_trace_map().
+ */
+#define E5_PRZ_PA        0xFFF80000UL
+#define E5_PRZ_DATA_OFF  27UL
+#define E5_PRZ_WIN_OFF   0x1F00UL
+#define E5_PRZ_WIN_SIZE  0x6000UL
+#define E5_PRZ_HDR_SIZE  8UL
+#define E5_PRZ_RING_SIZE (E5_PRZ_WIN_SIZE - E5_PRZ_HDR_SIZE)
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+void e5_trace_mark(void);
+
+static char * volatile e5_prz_win;
+static unsigned long e5_prz_pos;
+static int e5_prz_phase;
+
+void
+e5_trace_init(void)
+{
+e5_prz_phase = 0;
+e5_prz_win = NULL;
+e5_prz_pos = 0;
+}
+
+void
+e5_trace_map(void)
+{
+if (e5_prz_phase == 0) {
+e5_prz_win = (char *)ml_io_map(E5_PRZ_PA, 0x10000);
+if (e5_prz_win != NULL) {
+e5_prz_phase = 1;
+e5_trace_mark();
+}
+}
+}
+
+void
+e5_kputc(char c)
+{
+volatile char *base;
+volatile char *p;
+
+if (c == '\n') {
+e5_kputc('\r');
+}
+if ((e5_prz_phase == 1) && (e5_prz_win != NULL)) {
+base = (volatile char *)(e5_prz_win + E5_PRZ_DATA_OFF + E5_PRZ_WIN_OFF);
+} else {
+/*
+ * Bootstrap V=P identity mapping (VA == PA) installed by start.s
+ * covers the persistent zone until arm_vm_init() replaces the tables.
+ */
+base = (volatile char *)(E5_PRZ_PA + E5_PRZ_DATA_OFF + E5_PRZ_WIN_OFF);
+}
+p = base + E5_PRZ_HDR_SIZE + e5_prz_pos;
+*p = c;
+if (e5_prz_phase == 0) {
+__asm__ volatile ("dc cvac, %0" :: "r" ((void *) p) : "memory");
+}
+if (++e5_prz_pos >= E5_PRZ_RING_SIZE) {
+e5_prz_pos = 0;
+}
+/*
+ * Track the ring position in the window header so the BootShim rescue
+ * can locate the most recent console bytes (death/panic text) after a
+ * watchdog reset, without any kernel state surviving.
+ */
+if ((e5_prz_pos & 63UL) == 0) {
+volatile unsigned int *h = (volatile unsigned int *)base;
+h[0] = 0x57453545u; /* "E5TW" */
+h[1] = (unsigned int)e5_prz_pos;
+if (e5_prz_phase == 0) {
+__asm__ volatile ("dc cvac, %0" :: "r" ((void *) &h[0]) : "memory");
+__asm__ volatile ("dc cvac, %0" :: "r" ((void *) &h[1]) : "memory");
+}
+}
+}
+
+static void
+e5_doprnt_putc(char c)
+{
+e5_kputc(c);
+}
+
+void
+e5_panic_vprint(const char *fmt, va_list ap)
+{
+va_list copy;
+
+__builtin_va_copy(copy, ap);
+_doprnt(fmt, &copy, e5_doprnt_putc, 16);
+e5_kputc('\n');
+}
+
+void
+e5_panic_print(const char *s)
+{
+while (*s) {
+e5_kputc(*s++);
+}
+e5_kputc('\n');
+}
+
+void
+e5_trace_mark(void)
+{
+static const char mark[] = " E5XNU1 ";
+unsigned long i;
+
+for (i = 0; i < sizeof(mark) - 1; i++) {
+e5_kputc(mark[i]);
+}
+e5_kputc('\n');
+}
+
+void
+e5_trace_tag(const char *tag)
+{
+while (*tag != '\0') {
+e5_kputc(*tag++);
+}
+}
+
 static inline void
 _cnputc(char c, bool poll)
 {
+	e5_kputc(c);
 	if (boot_progress_active()) { boot_progress_putc(c); return; }
 	bool in_debugger = (kernel_debugger_entry_count > 0);
 	const uint32_t idx = get_cons_ops_index();
diff --git a/osfmk/kern/debug.c b/osfmk/kern/debug.c
index e9daeed..2cfd86d 100644
--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1023,6 +1023,12 @@ panic(const char *str, ...)
 	va_list panic_str_args;
 
 	va_start(panic_str_args, str);
+	{
+		extern void e5_panic_print(const char *);
+		extern void e5_panic_vprint(const char *, va_list);
+		e5_panic_print("E5PANIC: ");
+		e5_panic_vprint(str, panic_str_args);
+	}
 	panic_trap_to_debugger(str, &panic_str_args, 0, NULL, 0, NULL, (unsigned long)(char *)__builtin_return_address(0));
 	va_end(panic_str_args);
 }
