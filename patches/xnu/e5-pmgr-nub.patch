+// E5: register a bare ApplePMGRNub so AMFI finds a PMGR (null-provider no-op).
+#include <IOKit/IORegistryEntry.h>
+#include <libkern/c++/OSMetaClass.h>
+extern "C" void
+e5_pmgr_run(void)
+{
+    IOService *nub = OSDynamicCast(IOService, OSMetaClass::allocClassWithName("ApplePMGRNub"));
+    if (nub == NULL) { kprintf("E5-PMGR: metaclass not found%c", 10); return; }
+    if (nub->init() == 0) { kprintf("E5-PMGR: init failed%c", 10); return; }
+    if (nub->attachToParent(IORegistryEntry::getRegistryRoot(), gIOServicePlane) == 0) { kprintf("E5-PMGR: attach failed%c", 10); return; }
+    nub->registerService();
+    kprintf("E5-PMGR: ApplePMGRNub registered%c", 10);
+}
