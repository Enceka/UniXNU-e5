diff --git a/src/panfrost/lib/kmod/e5_kmod.c b/src/panfrost/lib/kmod/e5_kmod.c
new file mode 100644
index 0000000..f6f0483
--- /dev/null
+++ b/src/panfrost/lib/kmod/e5_kmod.c
@@ -0,0 +1,484 @@
+/* Copyright 2026 E5 contributors. SPDX-License-Identifier: MIT
+ * Darwin implementation of the JM kmod contract. GPU operations go through
+ * the E5MaliG1 UserClient; the kbase-named entry points are the existing JM
+ * queue interface, not Linux ioctl emulation. Submission is synchronous until
+ * a separate completion transport is qualified. No failed job becomes Done.
+ */
+#include <IOKit/IOKitLib.h>
+#include <mach/mach.h>
+#include <errno.h>
+#include <pthread.h>
+#include "pan_kmod_backend.h"
+#include "kbase_kmod.h"
+#include "E5MaliG1Abi.h"
+#include "E5MaliG1Ext.h"
+
+struct e5_bo {
+   struct pan_kmod_bo base;
+   uint64_t gpu;
+   mach_vm_address_t cpu;
+   mach_vm_size_t cpu_size;
+   bool borrowed_cpu;
+   bool owned_cpu;
+};
+struct e5_dev {
+   struct pan_kmod_dev base;
+   io_connect_t connection;
+   E5MaliGpuProperties hw;
+   pthread_mutex_t lock;
+   bool lost;
+   bool vm_live;
+   bool user_memory;
+   bool read_only_imports;
+   bool submit_wait;
+   size_t submit_bytes;
+   uint64_t completed;
+   uint64_t job_count;
+   struct e5_bo *live[E5_MALI_MAX_BO_HANDLES];
+};
+const struct pan_kmod_ops kbase_kmod_ops;
+bool e5_kmod_supports_user_memory(const struct pan_kmod_dev *dev);
+static struct e5_dev *edev(const struct pan_kmod_dev *d) { return container_of(d, struct e5_dev, base); }
+static struct e5_bo *ebo(struct pan_kmod_bo *b) { return container_of(b, struct e5_bo, base); }
+static kern_return_t call(struct e5_dev *d, uint32_t sel, const void *in, size_t ni, void *out, size_t no)
+{
+   size_t size = no;
+   kern_return_t rc = IOConnectCallStructMethod(d->connection, sel, in, ni, out, out ? &size : NULL);
+   if (!rc && out && size != no) rc = kIOReturnUnderrun;
+   if (rc) {
+      static unsigned reports;
+      if (p_atomic_inc_return(&reports) <= 16)
+         dprintf(229, "E5PANVK API_FAIL pid=%d selector=%u rc=%x in=%zu out=%zu\n",
+                 getpid(), sel, rc, ni, no);
+      mesa_loge("E5Mali selector %u failed: 0x%x", sel, rc);
+   }
+   return rc;
+}
+static void report_stats(struct e5_dev *d, const char *phase)
+{
+   E5MaliStats stats = {0};
+   if (call(d, kSelStats, NULL, 0, &stats, sizeof(stats))) return;
+   char text[252];
+   int n = snprintf(text, sizeof(text),
+      "E5PANVK %s sub=%llu comp=%llu fault=%llu tmo=%llu reset=%llu mmu=%llu active=%u mapped=%u bo=%u pid=%d\n",
+      phase, (unsigned long long)stats.submitted, (unsigned long long)stats.completed,
+      (unsigned long long)stats.faults, (unsigned long long)stats.timedOut,
+      (unsigned long long)stats.resets, (unsigned long long)stats.mmuFaults,
+      stats.activeAtoms, stats.mappedBytes, stats.liveBoBytes, getpid());
+   if (n > 0 && n < (int)sizeof(text)) {
+      if (write(229, text, n) != n) (void)write(2, text, n);
+   }
+}
+static struct pan_kmod_dev *create(int fd, uint32_t flags, const struct pan_kmod_driver *drv,
+                                  const struct pan_kmod_allocator *allocator)
+{
+   io_service_t service = IOServiceGetMatchingService(kIOMainPortDefault, IOServiceMatching("E5MaliG1"));
+   if (!service) { errno = ENODEV; return NULL; }
+   struct e5_dev *d = pan_kmod_alloc(allocator, sizeof(*d));
+   if (!d) { IOObjectRelease(service); return NULL; }
+   kern_return_t rc = IOServiceOpen(service, mach_task_self(), 0, &d->connection);
+   IOObjectRelease(service);
+   if (rc) { pan_kmod_free(allocator, d); return NULL; }
+   E5MaliInfo info = {0};
+   if (call(d, kSelGetVersion, NULL, 0, &info, sizeof(info)) || info.abiMajor != 1 || info.abiMinor < 1 ||
+       call(d, kSelGpuProperties, NULL, 0, &d->hw, sizeof(d->hw)) || d->hw.gpuId != 0x90910010 ||
+       !d->hw.vaBytes || !d->hw.maxBoHandles ||
+       d->hw.maxBoHandles > E5_MALI_MAX_BO_HANDLES ||
+       d->hw.maxSubmitBos < d->hw.maxBoHandles ||
+       d->hw.maxSubmitBos > E5_MALI_MAX_SUBMIT_BOS ||
+       (info.abiMinor < 6 && d->hw.maxBoHandles > 64)) {
+      IOServiceClose(d->connection); pan_kmod_free(allocator, d); errno = ENODEV; return NULL;
+   }
+   pan_kmod_dev_init(&d->base, -1,
+                    (flags & ~PAN_KMOD_DEV_FLAG_OWNS_FD) |
+                       PAN_KMOD_DEV_FLAG_MMAP_SYNC_THROUGH_KERNEL,
+                    drv, &kbase_kmod_ops, allocator);
+   d->user_memory = info.abiMinor >= 3;
+   d->read_only_imports = info.abiMinor >= 4;
+   const char *separate_wait = getenv("PANVK_E5_SEPARATE_WAIT");
+   d->submit_wait = info.abiMinor >= 7 && !(separate_wait && separate_wait[0] == '1');
+   d->submit_bytes = info.abiMinor >= 6 ? sizeof(E5MaliSubmitMany) : E5_MALI_LEGACY_SUBMIT_MANY_BYTES;
+   pthread_mutex_init(&d->lock, NULL);
+   struct pan_kmod_dev_props *p = &d->base.props;
+   p->gpu_id = d->hw.gpuId;
+   p->shader_present = d->hw.shaderPresent;
+   p->tiler_features = d->hw.tilerFeatures;
+   p->mem_features = d->hw.memFeatures;
+   p->mmu_features = d->hw.mmuFeatures;
+   p->l2_features = d->hw.l2Features;
+   memcpy(p->texture_features, d->hw.textureFeatures, sizeof(p->texture_features));
+   /* Zero-valued thread limits use the vendor's documented defaults. */
+   p->max_threads_per_core = d->hw.threadMaxThreads ? d->hw.threadMaxThreads : 256;
+   p->max_threads_per_wg = d->hw.threadMaxWorkgroup ? d->hw.threadMaxWorkgroup : 256;
+   p->max_tasks_per_core = MAX2(d->hw.threadFeatures >> 24, 1);
+   p->num_registers_per_core = d->hw.threadFeatures & 0xffff;
+   if (!p->num_registers_per_core) p->num_registers_per_core = p->max_threads_per_core * 32;
+   p->max_tls_instance_per_core = d->hw.threadTlsAlloc ? d->hw.threadTlsAlloc : p->max_threads_per_core;
+   p->pgsize_bitmap = PAN_PGSIZE_4K;
+   p->is_io_coherent = false;
+   /* ABI 1.1 CacheRange uses 64-byte lines on E5's A55/A76 CPUs. Darwin
+    * denies CTR_EL0 in this process; do not query it from userspace.
+    */
+   p->cache_sync_granularity = 64;
+   p->gpu_can_query_timestamp = false;
+   p->timestamp_cycles_to_ns_factor = 1.0; /* unused: timestamp support is disabled */
+   p->supported_bo_flags = PAN_KMOD_BO_FLAG_EXECUTABLE |
+                          PAN_KMOD_BO_FLAG_NO_MMAP | PAN_KMOD_BO_FLAG_WB_MMAP;
+   p->allowed_group_priorities_mask = PAN_KMOD_GROUP_ALLOW_PRIORITY_MEDIUM;
+   report_stats(d, "OPEN");
+   return &d->base;
+}
+static struct pan_kmod_va_range va_range(const struct pan_kmod_dev *dev)
+{
+   const struct e5_dev *d = edev(dev);
+   return (struct pan_kmod_va_range){ .start = d->hw.vaBase, .size = d->hw.vaBytes };
+}
+static void destroy(struct pan_kmod_dev *dev)
+{
+   struct e5_dev *d = edev(dev);
+   for (unsigned i = 0; i < d->hw.maxBoHandles; ++i)
+      if (d->live[i] && d->live[i]->cpu && !d->live[i]->borrowed_cpu)
+         IOConnectUnmapMemory64(d->connection, i + 1, mach_task_self(), d->live[i]->cpu);
+   report_stats(d, "CLOSE");
+   IOServiceClose(d->connection); /* kernel quiesces any failed context before freeing BOs */
+   for (unsigned i = 0; i < d->hw.maxBoHandles; ++i) {
+      if (!d->live[i]) continue;
+      /* Connection close restores the cache policy and unpins user pages
+       * before the owning anonymous mapping is released. */
+      if (d->live[i]->owned_cpu)
+         munmap((void *)(uintptr_t)d->live[i]->cpu, d->live[i]->cpu_size);
+      pan_kmod_dev_free(dev, d->live[i]);
+   }
+   pthread_mutex_destroy(&d->lock);
+   pan_kmod_dev_cleanup(dev);
+   pan_kmod_free(dev->allocator, d);
+}
+static void allocation_failure(struct e5_dev *d, const char *phase, uint64_t size, uint32_t flags)
+{
+   int saved = errno;
+   static unsigned reports;
+   if (p_atomic_inc_return(&reports) <= 16) {
+      dprintf(229, "E5PANVK ALLOC_FAIL pid=%d phase=%s bytes=%llu flags=%x errno=%d\n",
+              getpid(), phase, (unsigned long long)size, flags, saved);
+      report_stats(d, "ALLOC_STATE");
+   }
+   errno = saved;
+}
+static struct pan_kmod_bo *bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *vm,
+                                    uint64_t size, uint32_t flags)
+{
+   struct e5_dev *d = edev(dev);
+   if (!size || size > (256ull << 20) || flags & ~dev->props.supported_bo_flags) {
+      errno = EINVAL; allocation_failure(d, "arguments", size, flags); return NULL;
+   }
+   /* Without WB_MMAP, pan_kmod promises an uncached CPU mapping on a
+    * non-snooping GPU. IOBufferMemoryDescriptor's default mapping is cached,
+    * so it cannot back Vulkan HOST_COHERENT memory. Own a separate anonymous
+    * mapping and use ABI 1.3's per-page write-combining import instead. */
+   if (!(flags & (PAN_KMOD_BO_FLAG_WB_MMAP | PAN_KMOD_BO_FLAG_NO_MMAP))) {
+      if (!d->user_memory || (flags & PAN_KMOD_BO_FLAG_EXECUTABLE)) {
+         errno = ENOTSUP;
+         allocation_failure(d, "coherent-exec-or-abi", size, flags);
+         return NULL;
+      }
+      size = ALIGN_POT(size, 4096);
+      void *cpu = mmap(NULL, size, PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_ANON, -1, 0);
+      if (cpu == MAP_FAILED) { allocation_failure(d, "mmap", size, flags); return NULL; }
+      struct pan_kmod_bo *bo = kbase_kmod_bo_import_host(dev, cpu, size);
+      if (!bo) { allocation_failure(d, "import", size, flags); munmap(cpu, size); return NULL; }
+      ebo(bo)->owned_cpu = true;
+      bo->exclusive_vm = vm;
+      static unsigned reports;
+      if (p_atomic_inc_return(&reports) <= 8) {
+         char line[128];
+         int n = snprintf(line, sizeof(line), "E5PANVK COHERENT pid=%d bytes=%llu handle=%u\n",
+                          getpid(), (unsigned long long)size, bo->handle);
+         if (n > 0 && n < (int)sizeof(line)) (void)write(229, line, n);
+      }
+      return bo;
+   }
+   struct e5_bo *b = pan_kmod_dev_alloc(dev, sizeof(*b));
+   if (!b) return NULL;
+   E5MaliCreateBo in = { .size = size, .flags = flags & PAN_KMOD_BO_FLAG_EXECUTABLE ? 0 : 1 };
+   E5MaliCreateBoOut made = {0};
+   const char *phase = "create-bo";
+   pthread_mutex_lock(&d->lock);
+   if (d->lost || call(d, kSelCreateBo, &in, sizeof(in), &made, sizeof(made)) ||
+       made.status || !made.handle || made.handle > d->hw.maxBoHandles) goto fail;
+   E5MaliMapBo map = { .handle = made.handle, .flags = flags & PAN_KMOD_BO_FLAG_EXECUTABLE ? 0 : 2 };
+   phase = "gpu-map";
+   E5MaliMapBoOut mapped = {0};
+   if (call(d, kSelMapBo, &map, sizeof(map), &mapped, sizeof(mapped)) || mapped.status) goto fail;
+   b->gpu = mapped.va;
+   phase = "cpu-map";
+   if (!(flags & PAN_KMOD_BO_FLAG_NO_MMAP) &&
+       IOConnectMapMemory64(d->connection, made.handle, mach_task_self(), &b->cpu, &b->cpu_size, kIOMapAnywhere)) goto fail;
+   pan_kmod_bo_init(&b->base, dev, vm, made.size, flags, made.handle);
+   d->live[made.handle - 1] = b;
+   pthread_mutex_unlock(&d->lock);
+   return &b->base;
+fail:
+   allocation_failure(d, phase, size, flags);
+   if (b->cpu) IOConnectUnmapMemory64(d->connection, made.handle, mach_task_self(), b->cpu);
+   if (made.handle) { E5MaliDestroyBo drop = { .handle = made.handle }; call(d, kSelDestroyBo, &drop, sizeof(drop), NULL, 0); }
+   pthread_mutex_unlock(&d->lock); pan_kmod_dev_free(dev, b); return NULL;
+}
+static void bo_free(struct pan_kmod_bo *bo)
+{
+   struct e5_dev *d = edev(bo->dev); struct e5_bo *b = ebo(bo);
+   pan_kmod_bo_cleanup(bo);
+   pthread_mutex_lock(&d->lock);
+   if (b->cpu && !b->borrowed_cpu) {
+      if (IOConnectUnmapMemory64(d->connection, bo->handle, mach_task_self(), b->cpu)) {
+         d->lost = true;
+         pthread_mutex_unlock(&d->lock);
+         return;
+      }
+      b->cpu = 0;
+   }
+   E5MaliDestroyBo drop = { .handle = bo->handle };
+   if (call(d, kSelDestroyBo, &drop, sizeof(drop), NULL, 0)) {
+      d->lost = true; /* retain in live[] until connection close; never release active DMA pages */
+      pthread_mutex_unlock(&d->lock); return;
+   }
+   d->live[bo->handle - 1] = NULL;
+   pthread_mutex_unlock(&d->lock);
+   if (b->owned_cpu)
+      munmap((void *)(uintptr_t)b->cpu, b->cpu_size);
+   pan_kmod_dev_free(bo->dev, b);
+}
+static struct pan_kmod_bo *bo_import(struct pan_kmod_dev *d, uint32_t h, uint64_t n)
+{ (void)d; (void)h; (void)n; errno = ENOTSUP; return NULL; }
+bool e5_kmod_supports_user_memory(const struct pan_kmod_dev *dev)
+{
+   return edev(dev)->user_memory;
+}
+struct pan_kmod_bo *kbase_kmod_bo_import_host(struct pan_kmod_dev *dev, void *ptr, uint64_t size)
+{
+   struct e5_dev *d = edev(dev);
+   if (!d->user_memory) { errno = ENOTSUP; return NULL; }
+   if (!ptr || !size || size > (256ull << 20) || ((uintptr_t)ptr & 4095) || (size & 4095)) {
+      errno = EINVAL; return NULL;
+   }
+   struct e5_bo *b = pan_kmod_dev_alloc(dev, sizeof(*b));
+   if (!b) return NULL;
+   E5MaliImportUser request = { .address = (uintptr_t)ptr, .length = size };
+   E5MaliCreateBoOut made = {0};
+   E5MaliMapBoOut mapped = {0};
+   pthread_mutex_lock(&d->lock);
+   kern_return_t imported = d->lost ? kIOReturnNotReady :
+      call(d, kSelImportUser, &request, sizeof(request), &made, sizeof(made));
+   if (imported == KERN_PROTECTION_FAILURE && d->read_only_imports) {
+      request.flags = E5_MALI_IMPORT_READ_ONLY;
+      imported = call(d, kSelImportUser, &request, sizeof(request), &made, sizeof(made));
+      if (!imported && !made.status) {
+         static unsigned reports;
+         if (p_atomic_inc_return(&reports) <= 8)
+            dprintf(229, "E5PANVK IMPORT_RO pid=%d bytes=%llu handle=%u\n",
+                    getpid(), (unsigned long long)size, made.handle);
+      }
+   }
+   if (imported ||
+       made.status || !made.handle || made.handle > d->hw.maxBoHandles) goto fail;
+   E5MaliMapBo map = { .handle = made.handle, .flags = 2 };
+   if (call(d, kSelMapBo, &map, sizeof(map), &mapped, sizeof(mapped)) || mapped.status) goto fail;
+   b->gpu = mapped.va;
+   b->cpu = (uintptr_t)ptr; b->cpu_size = size; b->borrowed_cpu = true;
+   pan_kmod_bo_init(&b->base, dev, NULL, made.size, 0, made.handle);
+   d->live[made.handle - 1] = b;
+   pthread_mutex_unlock(&d->lock);
+   return &b->base;
+fail:
+   if (made.handle) {
+      E5MaliDestroyBo drop = { .handle = made.handle };
+      call(d, kSelDestroyBo, &drop, sizeof(drop), NULL, 0);
+   }
+   pthread_mutex_unlock(&d->lock);
+   pan_kmod_dev_free(dev, b);
+   return NULL;
+}
+static off_t bo_offset(struct pan_kmod_bo *b) { (void)b; errno = ENOTSUP; return -1; }
+static void *bo_mmap(struct pan_kmod_bo *bo, int prot, int flags, void *address)
+{
+   (void)flags; struct e5_bo *b = ebo(bo);
+   if (!b->cpu || (prot & PROT_EXEC) || (address && address != (void *)(uintptr_t)b->cpu)) { errno = EINVAL; return MAP_FAILED; }
+   return (void *)(uintptr_t)b->cpu;
+}
+static int bo_munmap(struct pan_kmod_bo *bo, void *address, size_t bytes)
+{
+   struct e5_bo *b = ebo(bo);
+   return address == (void *)(uintptr_t)b->cpu && bytes <= bo->size ? 0 : -1;
+}
+static int flush_maps(struct pan_kmod_dev *dev)
+{
+   struct e5_dev *d = edev(dev); int result = 0;
+   pthread_mutex_lock(&d->lock);
+   util_dynarray_foreach(&dev->pending_bo_syncs.array, struct pan_kmod_deferred_bo_sync, sync) {
+      if (sync->start > sync->bo->size || sync->size > sync->bo->size - sync->start) {
+         errno = EINVAL;
+         d->lost = true;
+         result = -1;
+         break;
+      }
+      uint64_t start = sync->start & ~63ull;
+      uint64_t end = MIN2(ALIGN_POT(sync->start + sync->size, 64), sync->bo->size);
+      if (end <= start) continue;
+      E5MaliCacheRange request = { .handle = sync->bo->handle, .offset = start, .length = end - start,
+         .operation = sync->type == PAN_KMOD_BO_SYNC_CPU_CACHE_FLUSH ? E5_MALI_CACHE_CLEAN : E5_MALI_CACHE_INVALIDATE };
+      if (call(d, kSelCacheRange, &request, sizeof(request), NULL, 0)) { d->lost = true; result = -1; break; }
+   }
+   pthread_mutex_unlock(&d->lock); return result;
+}
+static bool bo_wait(struct pan_kmod_bo *bo, int64_t timeout, bool read_only)
+{
+   (void)timeout; (void)read_only; struct e5_dev *d = edev(bo->dev);
+   pthread_mutex_lock(&d->lock); bool ready = !d->lost; pthread_mutex_unlock(&d->lock);
+   return ready; /* all submissions have completed before releasing lock */
+}
+static struct pan_kmod_vm *vm_create(struct pan_kmod_dev *dev, uint32_t flags, uint64_t start, uint64_t size)
+{
+   struct e5_dev *d = edev(dev);
+   if (d->vm_live || (size && (start < d->hw.vaBase || size > d->hw.vaBytes || start - d->hw.vaBase > d->hw.vaBytes - size))) return NULL;
+   struct pan_kmod_vm *vm = pan_kmod_dev_alloc(dev, sizeof(*vm));
+   if (!vm) return NULL;
+   pan_kmod_vm_init(vm, dev, 0, flags); d->vm_live = true; return vm;
+}
+static void vm_destroy(struct pan_kmod_vm *vm)
+{
+   struct pan_kmod_dev *dev = vm->dev; edev(dev)->vm_live = false;
+   pan_kmod_vm_cleanup(vm); pan_kmod_dev_free(dev, vm);
+}
+static int vm_bind(struct pan_kmod_vm *vm, enum pan_kmod_vm_op_mode mode, struct pan_kmod_vm_op *ops, uint32_t count)
+{
+   if (mode == PAN_KMOD_VM_OP_MODE_ASYNC || edev(vm->dev)->lost) return -1;
+   for (uint32_t i = 0; i < count; ++i) {
+      struct pan_kmod_vm_op *op = &ops[i];
+      if (op->wait.count || op->signal.count || op->flags) return -1;
+      if (op->type == PAN_KMOD_VM_OP_TYPE_MAP) {
+         if (!op->map.bo || op->map.bo_offset < 0 || (uint64_t)op->map.bo_offset > op->map.bo->size ||
+             !op->va.size || op->va.size > op->map.bo->size - op->map.bo_offset) return -1;
+         uint64_t address = ebo(op->map.bo)->gpu + op->map.bo_offset;
+         if (op->va.start != PAN_KMOD_VM_MAP_AUTO_VA && op->va.start != address) return -1;
+         op->va.start = address;
+      } else if (op->type != PAN_KMOD_VM_OP_TYPE_UNMAP && op->type != PAN_KMOD_VM_OP_TYPE_SYNC_ONLY) return -1;
+      /* The one kernel mapping belongs to the BO, like kbase SAME_VA. */
+   }
+   return 0;
+}
+static enum pan_kmod_vm_state vm_state(struct pan_kmod_vm *vm)
+{
+   struct e5_dev *d = edev(vm->dev);
+   pthread_mutex_lock(&d->lock);
+   enum pan_kmod_vm_state state = d->lost ? PAN_KMOD_VM_FAULTY : PAN_KMOD_VM_USABLE;
+   pthread_mutex_unlock(&d->lock);
+   return state;
+}
+static uint64_t timestamp(const struct pan_kmod_dev *dev) { (void)dev; errno = ENOTSUP; return 0; }
+
+uint64_t kbase_kmod_job_submit(struct pan_kmod_dev *dev, uint64_t jc, uint32_t request,
+                               struct pan_kmod_bo **bos, uint32_t count,
+                               struct base_external_resource *external, uint32_t nexternal)
+{
+   (void)external; struct e5_dev *d = edev(dev);
+   if (!count || count > d->hw.maxSubmitBos || nexternal) return 0;
+   E5MaliSubmitMany submit = { .jc = jc, .slot = request & BASE_JD_REQ_FS ? 0u : 1u };
+   for (uint32_t i = 0; i < count; ++i) {
+      if (!bos[i] || bos[i]->dev != dev) return 0;
+   }
+   E5MaliSubmitOut out = {0}; E5MaliWaitAtomOut done = {0};
+   pthread_mutex_lock(&d->lock);
+   /* Include immutable shaders and device-private buffers as well as the
+    * batch's explicit list. The lock prevents BO changes through real wait. */
+   for (unsigned i = 0; i < d->hw.maxBoHandles; ++i)
+      if (d->live[i]) submit.handles[submit.handleCount++] = i + 1;
+   if (d->lost) goto fail;
+   if (d->submit_wait) {
+      E5MaliSubmitWaitOut completed = {0};
+      if (call(d, kSelSubmitWaitMany, &submit, d->submit_bytes, &completed, sizeof(completed)) ||
+          completed.status || !completed.atomId || completed.state != kAtomDone || completed.hwStatus != 1) goto fail;
+      out.atomId = completed.atomId;
+   } else {
+      if (call(d, kSelSubmitMany, &submit, d->submit_bytes, &out, sizeof(out)) || out.status || !out.atomId) goto fail;
+      E5MaliWaitAtom wait = { .atomId = out.atomId, .timeoutMs = 500 };
+      if (call(d, kSelWaitAtom, &wait, sizeof(wait), &done, sizeof(done)) || done.status || done.state != kAtomDone || done.hwStatus != 1) goto fail;
+   }
+   d->completed = out.atomId;
+   uint64_t number = ++d->job_count;
+   if (number <= 8 || !(number & (number - 1))) {
+      char line[192];
+      int n = snprintf(line, sizeof(line), "E5PANVK DONE pid=%d job=%llu atom=%llu slot=%u hw=1 jc=%llx\n",
+                       getpid(), (unsigned long long)number, (unsigned long long)out.atomId,
+                       submit.slot, (unsigned long long)jc);
+      if (n > 0 && n < (int)sizeof(line)) (void)write(229, line, n);
+   }
+   pthread_mutex_unlock(&d->lock); return out.atomId;
+fail:
+   d->lost = true; pthread_mutex_unlock(&d->lock); return 0;
+}
+bool kbase_kmod_wait_atom(struct pan_kmod_dev *dev, uint64_t atom, int64_t timeout)
+{
+   (void)timeout; struct e5_dev *d = edev(dev); pthread_mutex_lock(&d->lock);
+   bool complete = atom && atom <= d->completed;
+   pthread_mutex_unlock(&d->lock); return complete;
+}
+uint64_t kbase_kmod_job_submit_dep(struct pan_kmod_dev *d, uint64_t jc, uint32_t req, struct pan_kmod_bo **bos, uint32_t n,
+                                  uint64_t dep0, uint8_t type0, uint64_t dep1, uint8_t type1, bool no_waiter)
+{
+   (void)type0; (void)type1; (void)no_waiter;
+   if ((dep0 && !kbase_kmod_wait_atom(d, dep0, -1)) || (dep1 && !kbase_kmod_wait_atom(d, dep1, -1))) return 0;
+   return kbase_kmod_job_submit(d, jc, req, bos, n, NULL, 0);
+}
+bool kbase_kmod_job_submit_retry(struct pan_kmod_dev *d, uint64_t jc, uint32_t req, struct pan_kmod_bo **bos, uint32_t n,
+                                struct base_external_resource *ext, uint32_t ne, int attempts)
+{ (void)attempts; return kbase_kmod_job_submit(d, jc, req, bos, n, ext, ne) != 0; }
+void kbase_kmod_atom_release(struct pan_kmod_dev *d, uint64_t atom) { (void)d; (void)atom; /* already retired after real wait */ }
+bool kbase_kmod_supports_dmabuf(const struct pan_kmod_dev *d) { (void)d; return false; }
+const struct drm_panthor_csif_info *kbase_kmod_get_csif_props(const struct pan_kmod_dev *d) { (void)d; return NULL; }
+uint32_t kbase_kmod_get_flush_id(const struct pan_kmod_dev *d) { (void)d; return 0; }
+const struct pan_kmod_ops kbase_kmod_ops = {
+   .dev_create = create, .dev_destroy = destroy, .dev_query_user_va_range = va_range,
+   .bo_alloc = bo_alloc, .bo_free = bo_free, .bo_import = bo_import,
+   .bo_get_mmap_offset = bo_offset, .bo_mmap = bo_mmap, .bo_munmap = bo_munmap,
+   .flush_bo_map_syncs = flush_maps, .bo_wait = bo_wait,
+   .vm_create = vm_create, .vm_destroy = vm_destroy, .vm_bind = vm_bind,
+   .vm_query_state = vm_state, .query_timestamp = timestamp,
+};
+
