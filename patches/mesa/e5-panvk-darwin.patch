diff --git a/src/panfrost/compiler/bifrost/test/test-interference.c b/src/panfrost/compiler/bifrost/test/test-interference.c
new file mode 100644
index 0000000..4cf0a5d
--- /dev/null
+++ b/src/panfrost/compiler/bifrost/test/test-interference.c
@@ -0,0 +1,317 @@
+/* SPDX-License-Identifier: MIT
+ * Differential interference and liveness tests with the original dense passes. */
+#include <time.h>
+#include "../bi_ra.c"
+static void
+reference_interference(bi_block *block, struct lcra_state *l, uint8_t *live,
+                       uint64_t preload_live, unsigned node_count,
+                       bool is_blend, bool split_file, unsigned arch)
+{
+   bool aligned_sr = arch >= 9;
+   bi_foreach_instr_in_block_rev(block, ins) {
+      /* Mark all registers live after the instruction as
+       * interfering with the destination */
+
+      bi_foreach_dest(ins, d) {
+         unsigned node = ins->dest[d].value;
+
+         /* Don't allocate to anything that's read later as a
+          * preloaded register. The affinity is the intersection
+          * of affinity masks for each write. Since writes have
+          * offsets, but the affinity is for the whole node, we
+          * need to offset the affinity opposite the write
+          * offset, so we shift right. */
+         unsigned count = bi_count_write_registers(ins, d);
+         unsigned offset = ins->dest[d].offset;
+         uint64_t affinity =
+            bi_make_affinity(preload_live, count, split_file) >> offset;
+         /* Valhall needs >= 64-bit staging writes to be pair-aligned */
+         if (aligned_sr && (count >= 2 || offset))
+            affinity &= EVEN_BITS_MASK;
+
+         l->affinity[node] &= affinity;
+
+         for (unsigned i = 0; i < node_count; ++i) {
+            uint8_t r = live[i];
+
+            /* Nodes only interfere if they occupy
+             * /different values/ at the same time
+             * (Boissinot). In particular, sources of
+             * moves do not interfere with their
+             * destinations. This enables a limited form of
+             * coalescing.
+             */
+            if (ins->op == BI_OPCODE_MOV_I32 && bi_is_ssa(ins->src[0]) &&
+                i == ins->src[0].value) {
+
+               r &= ~BITFIELD_BIT(ins->src[0].offset);
+            }
+
+            if (r) {
+               lcra_add_node_interference(l, node, bi_writemask(ins, d), i, r);
+            }
+         }
+
+         unsigned node_first = ins->dest[0].value;
+         if (d == 1) {
+            lcra_add_node_interference(l, node, bi_writemask(ins, 1),
+                                       node_first, bi_writemask(ins, 0));
+         }
+      }
+
+      /* Valhall needs >= 64-bit reads to be pair-aligned */
+      if (aligned_sr) {
+         bi_foreach_ssa_src(ins, s) {
+            if (bi_count_read_registers(ins, s) >= 2)
+               l->affinity[ins->src[s].value] &= EVEN_BITS_MASK;
+            else if (s < valhall_opcodes[ins->op].nr_srcs &&
+                     va_src_info(ins->op, s).size > VA_SIZE_32)
+               l->affinity[ins->src[s].value] &= EVEN_BITS_MASK;
+         }
+      }
+
+      if (!is_blend && ins->op == BI_OPCODE_BLEND) {
+         /* Blend shaders might clobber r0-r15, blend link reg. */
+         uint64_t clobber =
+            BITFIELD64_MASK(16) |
+            BITFIELD64_BIT(bi_preload_reg(BI_PRELOAD_BLEND_LINK, arch));
+
+         for (unsigned i = 0; i < node_count; ++i) {
+            if (live[i])
+               l->affinity[i] &= ~clobber;
+         }
+      }
+
+      /* Update live_in */
+      preload_live = bi_postra_liveness_ins(preload_live, ins);
+      bi_liveness_ins_update_ra(live, ins);
+   }
+
+   block->reg_live_in = preload_live;
+}
+
+static bool
+reference_block_update(bi_block *blk, unsigned temp_count)
+{
+   bool progress = false;
+
+   /* live_out[s] = sum { p in succ[s] } ( live_in[p] ) */
+   bi_foreach_successor(blk, succ) {
+      for (unsigned i = 0; i < temp_count; ++i)
+         blk->live_out[i] |= succ->live_in[i];
+   }
+
+   uint8_t *live = ralloc_array(blk, uint8_t, temp_count);
+   memcpy(live, blk->live_out, temp_count);
+
+   bi_foreach_instr_in_block_rev(blk, ins)
+      bi_liveness_ins_update_ra(live, ins);
+
+   /* To figure out progress, diff live_in */
+
+   for (unsigned i = 0; (i < temp_count) && !progress; ++i)
+      progress |= (blk->live_in[i] != live[i]);
+
+   ralloc_free(blk->live_in);
+   blk->live_in = live;
+
+   return progress;
+}
+
+/* Globally, liveness analysis uses a fixed-point algorithm based on a
+ * worklist. We initialize a work list with the exit block. We iterate the work
+ * list to compute live_in from live_out for each block on the work list,
+ * adding the predecessors of the block to the work list if we made progress.
+ */
+
+static void
+reference_liveness(bi_context *ctx)
+{
+   u_worklist worklist;
+   bi_worklist_init(ctx, &worklist);
+
+   bi_foreach_block(ctx, block) {
+      ralloc_free(block->live_in);
+      ralloc_free(block->live_out);
+
+      block->live_in = rzalloc_array(block, uint8_t, ctx->ssa_alloc);
+      block->live_out = rzalloc_array(block, uint8_t, ctx->ssa_alloc);
+
+      bi_worklist_push_tail(&worklist, block);
+   }
+
+   while (!u_worklist_is_empty(&worklist)) {
+      /* Pop off in reverse order since liveness is backwards */
+      bi_block *blk = bi_worklist_pop_tail(&worklist);
+
+      /* Update liveness information. If we made progress, we need to
+       * reprocess the predecessors
+       */
+      if (reference_block_update(blk, ctx->ssa_alloc)) {
+         bi_foreach_predecessor(blk, pred)
+            bi_worklist_push_head(&worklist, *pred);
+      }
+   }
+
+   u_worklist_fini(&worklist);
+}
+
+#define CHECK(x)                                                               \
+   do {                                                                        \
+      if (!(x)) {                                                              \
+         fprintf(stderr, "FAIL %d: %s\n", __LINE__, #x);                       \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+static double
+now(void)
+{
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   return t.tv_sec + t.tv_nsec * 1e-9;
+}
+
+static void
+test_cfg(void)
+{
+   for (unsigned variant = 0; variant < 3; ++variant) {
+      unsigned blocks = variant ? 256 : 32, count = variant ? 24576 : 259;
+      bi_context *ctx = rzalloc(NULL, bi_context);
+      ctx->arch = 9;
+      ctx->ssa_alloc = count;
+      ctx->num_blocks = blocks;
+      list_inithead(&ctx->blocks);
+      bi_block **bb = calloc(blocks, sizeof(*bb));
+      for (unsigned j = 0; j < blocks; ++j) {
+         bb[j] = rzalloc(ctx, bi_block);
+         bb[j]->index = j;
+         list_inithead(&bb[j]->instructions);
+         list_addtail(&bb[j]->link, &ctx->blocks);
+         util_dynarray_init(&bb[j]->predecessors, bb[j]);
+         bi_builder b = bi_init_builder(ctx, bi_after_block(bb[j]));
+         for (unsigned k = 0; k < 10; ++k) {
+            unsigned n = (j * 83 + k) % count;
+            bi_index dest = bi_get_index(n),
+                     src = bi_get_index((n + count - 1) % count);
+            dest.offset = k % 4;
+            src.offset = (k + 1) % 4;
+            bi_mov_i32_to(&b, dest, src);
+         }
+      }
+      for (unsigned j = 0; j < blocks; ++j) {
+         if (j + 1 < blocks) {
+            bb[j]->successors[0] = bb[j + 1];
+            util_dynarray_append(&bb[j + 1]->predecessors, bb[j]);
+         }
+         if (variant && j % 17 == 0) {
+            bb[j]->successors[1] = bb[j];
+            util_dynarray_append(&bb[j]->predecessors, bb[j]);
+         }
+         if (variant == 2 && j == blocks - 1) {
+            bb[j]->successors[0] = bb[blocks / 2];
+            util_dynarray_append(&bb[blocks / 2]->predecessors, bb[j]);
+         }
+      }
+      double t = now();
+      reference_liveness(ctx);
+      double before = now() - t;
+      uint8_t *expected = malloc((size_t)blocks * count * 2);
+      for (unsigned j = 0; j < blocks; ++j) {
+         memcpy(expected + (size_t)j * count * 2, bb[j]->live_in, count);
+         memcpy(expected + ((size_t)j * 2 + 1) * count, bb[j]->live_out, count);
+      }
+      t = now();
+      bi_compute_liveness_ra(ctx);
+      double after = now() - t;
+      for (unsigned j = 0; j < blocks; ++j) {
+         CHECK(memcmp(expected + (size_t)j * count * 2, bb[j]->live_in,
+                      count) == 0);
+         CHECK(memcmp(expected + ((size_t)j * 2 + 1) * count, bb[j]->live_out,
+                      count) == 0);
+      }
+      printf(
+         "PASS liveness nodes=%u blocks=%u cfg=%u old=%.6f new=%.6f speedup=%.2f all fixed-point component masks exact\n",
+         count, blocks, variant, before, after, before / after);
+      free(expected);
+      free(bb);
+      ralloc_free(ctx);
+   }
+}
+int
+main(void)
+{
+   unsigned sizes[] = {257, 4096, 24000};
+   for (unsigned c = 0; c < 3; ++c) {
+      unsigned count = sizes[c];
+      bi_context *ctx = rzalloc(NULL, bi_context);
+      ctx->arch = 9;
+      ctx->ssa_alloc = count;
+      list_inithead(&ctx->blocks);
+      bi_block *block = rzalloc(ctx, bi_block);
+      list_inithead(&block->instructions);
+      list_addtail(&block->link, &ctx->blocks);
+      bi_builder b = bi_init_builder(ctx, bi_after_block(block));
+      for (unsigned i = 0; i < count; ++i) {
+         bi_index dst = bi_get_index(i),
+                  src = i ? bi_get_index(i - 1) : bi_imm_u32(0);
+         if (c == 0) {
+            dst.offset = i % 4;
+            if (i)
+               src.offset = (i - 1) % 4;
+         }
+         if (c == 0 && i >= 16 && i % 17 == 0)
+            bi_blend_to(&b, dst, src, bi_imm_u32(0), bi_imm_u32(0),
+                        bi_imm_u32(0), bi_get_index(i - 16),
+                        BI_REGISTER_FORMAT_F32, 1, 1);
+         else if (c == 0 && i >= 16 && i % 19 == 0)
+            bi_texc_dual_to(&b, dst, bi_get_index(i - 2), src, bi_imm_u32(0),
+                            bi_imm_u32(0), bi_imm_u32(0), false, 1, 1);
+         else if (i % 3 == 0)
+            bi_mov_i32_to(&b, dst, src);
+         else
+            bi_iadd_u32_to(&b, dst, src,
+                           i >= 16 ? bi_get_index(i - 16) : bi_imm_u32(1),
+                           false);
+      }
+      for (unsigned variant = 0; variant < 4; ++variant) {
+         uint8_t *live0 = calloc(count, 1), *live1 = calloc(count, 1);
+         live0[count - 1] = live1[count - 1] = 15;
+         struct lcra_state *a = lcra_alloc_equations(count),
+                           *z = lcra_alloc_equations(count);
+         for (unsigned i = 0; i < count; ++i)
+            a->affinity[i] = z->affinity[i] = ~0ull;
+         double t = now();
+         reference_interference(block, a, live0, 5, count, variant & 1,
+                                variant & 2, variant & 1 ? 7 : 9);
+         double before = now() - t;
+         uint64_t preload = block->reg_live_in;
+         t = now();
+         bi_mark_interference(block, z, live1, 5, count, variant & 1,
+                              variant & 2, variant & 1 ? 7 : 9);
+         double after = now() - t;
+         CHECK(block->reg_live_in == preload);
+         CHECK(memcmp(live0, live1, count) == 0);
+         CHECK(memcmp(a->affinity, z->affinity, count * sizeof(uint64_t)) == 0);
+         for (unsigned i = 0; i < count; ++i) {
+            nodearray *x = &a->linear[i], *y = &z->linear[i];
+            CHECK(x->size == y->size);
+            CHECK(x->sparse_capacity == y->sparse_capacity);
+            if (x->size)
+               CHECK(memcmp(x->sparse, y->sparse,
+                            x->size * (nodearray_is_sparse(x)
+                                          ? sizeof(nodearray_sparse)
+                                          : sizeof(nodearray_value))) == 0);
+         }
+         printf(
+            "PASS nodes=%u variant=%u old=%.6f new=%.6f speedup=%.2f constraints/affinity/live exact\n",
+            count, variant, before, after, before / after);
+         lcra_free(a);
+         lcra_free(z);
+         free(live0);
+         free(live1);
+      }
+      ralloc_free(ctx);
+   }
+   test_cfg();
+   return 0;
+}
