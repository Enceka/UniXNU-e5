// SPDX-License-Identifier: BSD-3-Clause
/dts-v1/;
/include/ "ums9621.dtsi"

/ {
    model = "Rongyue E5";
    compatible = "rongyue,e5", "sprd,ums9621";

    // r84 regression: the hand-augmented ADT always carried /filesystems
    // DoNotUseSEP=1, which AppleAPFS reads (gate at apfs_vfsops.c:2276) to
    // allow mounting the unencrypted Data volume. CI dts-built ADTs lacked
    // the node -> "unencrypted data volume is not allowed" panic.
    filesystems {
        DoNotUseSEP = <1>;
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0 0x80000000 0 0x80000000>;
    };

    soc {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        // v2 display bring-up: IOMobileFramebufferLegacy expects a provider
        // service named "lcd" (AppleARMPlatform publishes ADT device nodes
        // as IOPlatformDevice/AppleARMIODevice instances).
        lcd@0 {
            compatible = "lcd";
            device_type = "display-subsystem";
            unixnu,adt-name = "lcd";
        };
    };
};
